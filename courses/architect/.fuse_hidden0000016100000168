<span class="kw">import</span> logging
<span class="kw">import</span> json
<span class="kw">from</span> datetime <span class="kw">import</span> datetime
<span class="kw">import</span> getpass

audit_logger <span class="op">=</span> logging.<span class="fn">getLogger</span>(<span class="st">"audit"</span>)

<span class="kw">def</span> <span class="fn">log_model_deployment</span>(
    model_id: <span class="va">str</span>,
    version: <span class="va">str</span>,
    approved_by: <span class="va">str</span>,
    deployment_pct: <span class="va">int</span>
):
    <span class="va">audit_event</span> <span class="op">=</span> {
        <span class="st">"timestamp"</span>: datetime.utcnow().<span class="fn">isoformat</span>(),
        <span class="st">"event_type"</span>: <span class="st">"model_deployment"</span>,
        <span class="st">"model_id"</span>: model_id,
        <span class="st">"version"</span>: version,
        <span class="st">"approved_by"</span>: approved_by,
        <span class="st">"deployment_percentage"</span>: deployment_pct,
        <span class="st">"operator"</span>: getpass.<span class="fn">getuser</span>(),
        <span class="st">"ip_address"</span>: os.<span class="fn">getenv</span>(<span class="st">'CLIENT_IP'</span>)
    }
    audit_logger.<span class="fn">info</span>(json.<span class="fn">dumps</span>(<span class="va">audit_event</span>))

<span class="cm"># Store in immutable audit log (database, file, or event stream)</span>
<span class="fn">store_in_audit_log</span>(<span class="va">audit_event</span>)</code></pre>
  <div class="code-explain">
    <p><strong>What is happening:</strong> We create a structured audit event with timestamp, actor, action, and context. This is logged to an immutable audit trail. In production, this goes to a dedicated audit log service that enforces retention policies and prevents tampering.</p>
  </div>

  <div class="key-takeaway">
    <h4>✦ Key Takeaways</h4>
    <ul>
      <li>Implement immutable audit logs for all model changes and predictions</li>
      <li>Track: who made the change, what changed, when, where, and why</li>
      <li>Store audit logs separately from operational logs (never delete)</li>
      <li>Enable compliance queries: "which models used this customer's data?"</li>
      <li>Rotate and compress logs, but never delete historical records</li>
    </ul>
  </div>
