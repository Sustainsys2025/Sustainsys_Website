  <section class="section" id="dependency-injection">
    <h2>Model Loading with Dependency Injection</h2>
    <p>Use FastAPI's dependency injection to manage model lifecycle efficiently:</p>
    <div class="code-example"><code><span class="im">from</span> <span class="nm">fastapi</span> <span class="im">import</span> <span class="nm">Depends</span>
<span class="im">from</span> <span class="nm">functools</span> <span class="im">import</span> <span class="nm">lru_cache</span>

<span class="kw">class</span> <span class="nm">ModelContainer</span><span class="op">:</span>
    <span class="kw">def</span> <span class="fn">__init__</span><span class="op">(</span><span class="nm">self</span><span class="op">):</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">model</span> <span class="op">=</span> <span class="kw">None</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">tokenizer</span> <span class="op">=</span> <span class="kw">None</span>

    <span class="kw">async def</span> <span class="fn">initialize</span><span class="op">(</span><span class="nm">self</span><span class="op">,</span> <span class="nm">model_path</span><span class="op">:</span> <span class="bi">str</span><span class="op">):</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">model</span> <span class="op">=</span> <span class="fn">load_model</span><span class="op">(</span><span class="nm">model_path</span><span class="op">)</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">tokenizer</span> <span class="op">=</span> <span class="fn">load_tokenizer</span><span class="op">()</span>

<span class="op">@</span><span class="fn">lru_cache</span><span class="op">()</span>
<span class="kw">def</span> <span class="fn">get_model</span><span class="op">():</span>
    <span class="kw">return</span> <span class="nm">ModelContainer</span><span class="op">()</span>

<span class="nm">app</span> <span class="op">=</span> <span class="fn">FastAPI</span><span class="op">()</span>
<span class="nm">model_container</span> <span class="op">=</span> <span class="fn">get_model</span><span class="op">()</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">on_event</span><span class="op">(</span><span class="st">"startup"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">startup_event</span><span class="op">():</span>
    <span class="kw">await</span> <span class="nm">model_container</span><span class="op">.</span><span class="fn">initialize</span><span class="op">(</span><span class="st">"./models/classifier"</span><span class="op">)</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/predict"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">predict</span><span class="op">(</span>
    <span class="nm">request</span><span class="op">:</span> <span class="nm">TextRequest</span><span class="op">,</span>
    <span class="nm">container</span><span class="op">:</span> <span class="nm">ModelContainer</span> <span class="op">=</span> <span class="fn">Depends</span><span class="op">(</span><span class="fn">get_model</span><span class="op">)</span>
<span class="op">):</span>
    <span class="nm">tokens</span> <span class="op">=</span> <span class="nm">container</span><span class="op">.</span><span class="nm">tokenizer</span><span class="op">.</span><span class="fn">encode</span><span class="op">(</span><span class="nm">request</span><span class="op">.</span><span class="nm">text</span><span class="op">)</span>
    <span class="nm">output</span> <span class="op">=</span> <span class="nm">container</span><span class="op">.</span><span class="nm">model</span><span class="op">.</span><span class="fn">predict</span><span class="op">(</span><span class="nm">tokens</span><span class="op">)</span>
    <span class="kw">return</span> <span class="nm">output</span></code></div>
  </section>

  <section class="section" id="batch-jobs">
    <h2>Batch Processing with Job Tracking</h2>
    <p>For large-scale predictions, implement async batch jobs with status tracking:</p>
    <div class="code-example"><code><span class="im">import</span> <span class="nm">uuid</span>
<span class="im">from</span> <span class="nm">enum</span> <span class="im">import</span> <span class="nm">Enum</span>

<span class="kw">class</span> <span class="nm">JobStatus</span><span class="op">(</span><span class="nm">str</span><span class="op">,</span> <span class="nm">Enum</span><span class="op">):</span>
    <span class="nm">PENDING</span> <span class="op">=</span> <span class="st">"pending"</span>
    <span class="nm">PROCESSING</span> <span class="op">=</span> <span class="st">"processing"</span>
    <span class="nm">COMPLETED</span> <span class="op">=</span> <span class="st">"completed"</span>
    <span class="nm">FAILED</span> <span class="op">=</span> <span class="st">"failed"</span>

<span class="nm">jobs</span> <span class="op">=</span> <span class="op">{}</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/batch-predict"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">submit_batch</span><span class="op">(</span><span class="nm">request</span><span class="op">:</span> <span class="nm">BatchRequest</span><span class="op">):</span>
    <span class="nm">job_id</span> <span class="op">=</span> <span class="fn">str</span><span class="op">(</span><span class="fn">uuid</span><span class="op">.</span><span class="fn">uuid4</span><span class="op">())</span>
    <span class="nm">jobs</span><span class="op">[</span><span class="nm">job_id</span><span class="op">]</span> <span class="op">=</span> <span class="op">{</span>
        <span class="st">"status"</span><span class="op">:</span> <span class="nm">JobStatus</span><span class="op">.</span><span class="nm">PENDING</span><span class="op">,</span>
        <span class="st">"progress"</span><span class="op">:</span> <span class="nm">0</span><span class="op">,</span>
        <span class="st">"total"</span><span class="op">:</span> <span class="fn">len</span><span class="op">(</span><span class="nm">request</span><span class="op">.</span><span class="nm">items</span><span class="op">)</span>
    <span class="op">}</span>

    <span class="cm"># Queue async task</span>
    <span class="nm">asyncio</span><span class="op">.</span><span class="fn">create_task</span><span class="op">(</span><span class="fn">process_batch</span><span class="op">(</span><span class="nm">job_id</span><span class="op">,</span> <span class="nm">request</span><span class="op">.</span><span class="nm">items</span><span class="op">))</span>

    <span class="kw">return</span> <span class="op">{</span><span class="st">"job_id"</span><span class="op">:</span> <span class="nm">job_id</span><span class="op">}</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">get</span><span class="op">(</span><span class="st">"/batch-status/{job_id}"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">get_batch_status</span><span class="op">(</span><span class="nm">job_id</span><span class="op">:</span> <span class="bi">str</span><span class="op">):</span>
    <span class="kw">if</span> <span class="nm">job_id</span> <span class="kw">not</span> <span class="kw">in</span> <span class="nm">jobs</span><span class="op">:</span>
        <span class="kw">raise</span> <span class="fn">HTTPException</span><span class="op">(</span><span class="nm">status_code</span><span class="op">=</span><span class="nm">404</span><span class="op">)</span>
    <span class="kw">return</span> <span class="nm">jobs</span><span class="op">[</span><span class="nm">job_id</span><span class="op">]</span></code></div>
  </section>

