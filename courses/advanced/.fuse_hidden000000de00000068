  <section class="section" id="validation">
    <h2>Request and Response Validation</h2>
    <p>Pydantic models provide automatic validation of request bodies and can define response schemas:</p>
    <div class="code-example"><code><span class="im">from</span> <span class="nm">pydantic</span> <span class="im">import</span> <span class="nm">BaseModel</span><span class="op">,</span> <span class="nm">Field</span>
<span class="im">from</span> <span class="nm">typing</span> <span class="im">import</span> <span class="nm">Optional</span>

<span class="kw">class</span> <span class="nm">TextInput</span><span class="op">(</span><span class="nm">BaseModel</span><span class="op">):</span>
    <span class="nm">text</span><span class="op">:</span> <span class="bi">str</span> <span class="op">=</span> <span class="fn">Field</span><span class="op">(...,</span> <span class="nm">min_length</span><span class="op">=</span><span class="nm">1</span><span class="op">,</span> <span class="nm">max_length</span><span class="op">=</span><span class="nm">1000</span><span class="op">)</span>
    <span class="nm">language</span><span class="op">:</span> <span class="bi">str</span> <span class="op">=</span> <span class="st">"en"</span>
    <span class="nm">confidence_threshold</span><span class="op">:</span> <span class="bi">float</span> <span class="op">=</span> <span class="fn">Field</span><span class="op">(</span><span class="nm">0</span><span class="op">.</span><span class="nm">5</span><span class="op">,</span> <span class="nm">ge</span><span class="op">=</span><span class="nm">0</span><span class="op">,</span> <span class="nm">le</span><span class="op">=</span><span class="nm">1</span><span class="op">)</span>

<span class="kw">class</span> <span class="nm">PredictionResponse</span><span class="op">(</span><span class="nm">BaseModel</span><span class="op">):</span>
    <span class="nm">result</span><span class="op">:</span> <span class="bi">str</span>
    <span class="nm">confidence</span><span class="op">:</span> <span class="bi">float</span>
    <span class="nm">processing_time_ms</span><span class="op">:</span> <span class="bi">float</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/classify"</span><span class="op">,</span> <span class="nm">response_model</span><span class="op">=</span><span class="nm">PredictionResponse</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">classify_text</span><span class="op">(</span><span class="nm">input_data</span><span class="op">:</span> <span class="nm">TextInput</span><span class="op">):</span>
    <span class="cm"># FastAPI automatically validates input_data matches TextInput schema</span>
    <span class="kw">return</span> <span class="nm">PredictionResponse</span><span class="op">(</span>
        <span class="nm">result</span><span class="op">=</span><span class="st">"positive"</span><span class="op">,</span>
        <span class="nm">confidence</span><span class="op">=</span><span class="nm">0</span><span class="op">.</span><span class="nm">94</span><span class="op">,</span>
        <span class="nm">processing_time_ms</span><span class="op">=</span><span class="nm">142</span><span class="op">.</span><span class="nm">5</span>
    <span class="op">)</span></code></div>

    <div class="callout">
      <div class="callout-title">Benefits of Type Hints</div>
      <p>Define your data structure once with Pydantic. FastAPI handles validation, serialization, and documentation automatically. Invalid requests are rejected with clear error messages.</p>
    </div>
  </section>

  <section class="section" id="async">
    <h2>Async/Await Patterns</h2>
    <p>FastAPI's async support enables handling many concurrent requests efficiently. Use async functions for I/O-bound operations like API calls or database queries:</p>
    <div class="code-example"><code><span class="im">import</span> <span class="nm">asyncio</span>
<span class="im">import</span> <span class="nm">httpx</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/inference"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">run_inference</span><span class="op">(</span><span class="nm">request</span><span class="op">:</span> <span class="nm">TextInput</span><span class="op">):</span>
    <span class="cm"># Multiple async operations run concurrently</span>
    <span class="kw">async with</span> <span class="nm">httpx</span><span class="op">.</span><span class="nm">AsyncClient</span><span class="op">()</span> <span class="kw">as</span> <span class="nm">client</span><span class="op">:</span>
        <span class="nm">response</span> <span class="op">=</span> <span class="kw">await</span> <span class="nm">client</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span>
            <span class="st">"https://api.example.com/predict"</span><span class="op">,</span>
            <span class="nm">json</span><span class="op">=</span><span class="op">{</span><span class="st">"text"</span><span class="op">:</span> <span class="nm">request</span><span class="op">.</span><span class="nm">text</span><span class="op">}</span>
        <span class="op">)</span>
        <span class="nm">result</span> <span class="op">=</span> <span class="nm">response</span><span class="op">.</span><span class="fn">json</span><span class="op">()</span>

    <span class="kw">return</span> <span class="nm">result</span>

<span class="cm"># Mix sync and async - use sync for CPU-bound ML inference</span>
<span class="kw">def</span> <span class="fn">cpu_intensive_model</span><span class="op">(</span><span class="nm">text</span><span class="op">:</span> <span class="bi">str</span><span class="op">):</span>
    <span class="cm"># Model inference (CPU-bound)</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"label"</span><span class="op">:</span> <span class="st">"positive"</span><span class="op">}</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/predict"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">predict</span><span class="op">(</span><span class="nm">request</span><span class="op">:</span> <span class="nm">TextInput</span><span class="op">):</span>
    <span class="cm"># Offload CPU work to thread pool</span>
    <span class="nm">result</span> <span class="op">=</span> <span class="kw">await</span> <span class="nm">asyncio</span><span class="op">.</span><span class="fn">to_thread</span><span class="op">(</span>
        <span class="nm">cpu_intensive_model</span><span class="op">,</span> <span class="nm">request</span><span class="op">.</span><span class="nm">text</span>
    <span class="op">)</span>
    <span class="kw">return</span> <span class="nm">result</span></code></div>
  </section>

  <section class="section" id="docs">
    <h2>Automatic Documentation</h2>
    <p>FastAPI generates interactive API documentation automatically from your code and type hints. No extra configuration needed:</p>
    <div class="code-example"><code><span class="nm">app</span> <span class="op">=</span> <span class="fn">FastAPI</span><span class="op">(</span>
    <span class="nm">title</span><span class="op">=</span><span class="st">"AI Inference API"</span><span class="op">,</span>
    <span class="nm">description</span><span class="op">=</span><span class="st">"Production AI model serving"</span><span class="op">,</span>
    <span class="nm">version</span><span class="op">=</span><span class="st">"1.0.0"</span>
<span class="op">)</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span>
    <span class="st">"/predictions"</span><span class="op">,</span>
    <span class="nm">summary</span><span class="op">=</span><span class="st">"Run model inference"</span><span class="op">,</span>
    <span class="nm">description</span><span class="op">=</span><span class="st">"Execute inference on text input using deployed model"</span><span class="op">,</span>
    <span class="nm">tags</span><span class="op">=</span><span class="op">[</span><span class="st">"Inference"</span><span class="op">]</span>
<span class="op">)</span>
<span class="kw">async def</span> <span class="fn">predict</span><span class="op">(</span><span class="nm">request</span><span class="op">:</span> <span class="nm">TextInput</span><span class="op">):</span>
    <span class="st">"""
    Make a prediction on text input.

    - **text**: The input text (1-1000 chars)
    - **language**: Language code (default: en)
    - **confidence_threshold**: Min confidence to return (0-1)
    """</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"result"</span><span class="op">:</span> <span class="st">"positive"</span><span class="op">}</span></code></div>

    <p>Access documentation at:</p>
    <ul>
      <li><code>/docs</code> - Interactive Swagger UI for testing endpoints</li>
      <li><code>/redoc</code> - Clean ReDoc documentation</li>
      <li><code>/openapi.json</code> - OpenAPI 3.0 specification file</li>
    </ul>
  </section>

  <section class="section" id="errors">
    <h2>Error Handling</h2>
    <p>FastAPI provides built-in HTTP exceptions and custom error handling:</p>
    <div class="code-example"><code><span class="im">from</span> <span class="nm">fastapi</span> <span class="im">import</span> <span class="nm">HTTPException</span><span class="op">,</span> <span class="nm">status</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">get</span><span class="op">(</span><span class="st">"/models/{model_id}"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">get_model</span><span class="op">(</span><span class="nm">model_id</span><span class="op">:</span> <span class="bi">int</span><span class="op">):</span>
    <span class="kw">if</span> <span class="nm">model_id</span> <span class="op">==</span> <span class="nm">999</span><span class="op">:</span>
        <span class="kw">raise</span> <span class="fn">HTTPException</span><span class="op">(</span>
            <span class="nm">status_code</span><span class="op">=</span><span class="nm">status</span><span class="op">.</span><span class="nm">HTTP_404_NOT_FOUND</span><span class="op">,</span>
            <span class="nm">detail</span><span class="op">=</span><span class="st">"Model not found"</span>
        <span class="op">)</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"model_id"</span><span class="op">:</span> <span class="nm">model_id</span><span class="op">}</span>

<span class="cm"># Custom exception handler</span>
<span class="kw">class</span> <span class="nm">ModelError</span><span class="op">(</span><span class="nm">Exception</span><span class="op">):</span>
    <span class="kw">def</span> <span class="fn">__init__</span><span class="op">(</span><span class="nm">self</span><span class="op">,</span> <span class="nm">message</span><span class="op">:</span> <span class="bi">str</span><span class="op">):</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">message</span> <span class="op">=</span> <span class="nm">message</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">exception_handler</span><span class="op">(</span><span class="nm">ModelError</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">model_error_handler</span><span class="op">(</span><span class="nm">request</span><span class="op">,</span> <span class="nm">exc</span><span class="op">):</span>
    <span class="kw">return</span> <span class="fn">JSONResponse</span><span class="op">(</span>
        <span class="nm">status_code</span><span class="op">=</span><span class="nm">500</span><span class="op">,</span>
        <span class="nm">content</span><span class="op">=</span><span class="op">{</span><span class="st">"error"</span><span class="op">:</span> <span class="nm">exc</span><span class="op">.</span><span class="nm">message</span><span class="op">}</span>
    <span class="op">)</span></code></div>
  </section>

