    </div>
    <div class="pipeline-arrow">→</div>
    <div class="pipeline-step">
      <div class="step-icon">✓</div>
      <div class="step-label">Use Cognitive Services</div>
      <div class="step-desc">Fast, production-ready</div>
    </div>
  </div>

  <div class="pipeline">
    <div class="pipeline-step">
      <div class="step-icon">?</div>
      <div class="step-label">Need state-of-the-art language AI?</div>
      <div class="step-desc">(generation, understanding, chat)</div>
    </div>
    <div class="pipeline-arrow">→</div>
    <div class="pipeline-step">
      <div class="step-icon">✓</div>
      <div class="step-label">Use Azure OpenAI</div>
      <div class="step-desc">Fine-tuning supported</div>
    </div>
  </div>

  <div class="pipeline">
    <div class="pipeline-step">
      <div class="step-icon">?</div>
      <div class="step-label">Need custom model for proprietary data?</div>
      <div class="step-desc">(specialized domain, high accuracy)</div>
    </div>
    <div class="pipeline-arrow">→</div>
    <div class="pipeline-step">
      <div class="step-icon">✓</div>
      <div class="step-label">Use Azure Machine Learning</div>
      <div class="step-desc">Full MLOps platform</div>
    </div>
  </div>

  <div class="compare-grid">
    <div class="compare-card">
      <h5>Cognitive Services</h5>
      <ul>
        <li>✓ Standard problems (OCR, translation, sentiment)</li>
        <li>✓ Pre-trained models, instant deployment</li>
        <li>✓ Low cost for high volume</li>
        <li>✗ Limited customization</li>
      </ul>
    </div>
    <div class="compare-card">
      <h5>Azure OpenAI</h5>
      <ul>
        <li>✓ LLM-based applications (chat, generation)</li>
        <li>✓ Fine-tuning on domain data</li>
        <li>✓ Enterprise-grade availability</li>
        <li>✗ More expensive per token</li>
      </ul>
    </div>
    <div class="compare-card">
      <h5>Azure Machine Learning</h5>
      <ul>
        <li>✓ Custom models for unique problems</li>
        <li>✓ Full MLOps (experimentation, versioning)</li>
        <li>✓ Highest accuracy potential</li>
        <li>✗ Requires ML expertise and time</li>
      </ul>
    </div>
  </div>

