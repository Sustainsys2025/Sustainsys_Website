  <div class="objectives"><h4>Learning Objectives</h4><ul>
    <li>Implement JWT-based authentication for API tokens</li>
    <li>Secure endpoints with bearer token validation</li>
    <li>Build rate limiting middleware with token bucket algorithm</li>
    <li>Implement per-user and per-endpoint quotas</li>
    <li>Design tiered API access plans</li>
  </ul></div>

  <section class="section" id="jwt-auth">
    <h2>JWT Authentication</h2>
    <p>JSON Web Tokens provide stateless authentication for APIs. FastAPI makes token generation and validation simple:</p>
    <div class="code-example"><code><span class="im">from</span> <span class="nm">fastapi</span> <span class="im">import</span> <span class="nm">FastAPI</span><span class="op">,</span> <span class="nm">Depends</span><span class="op">,</span> <span class="nm">HTTPException</span>
<span class="im">from</span> <span class="nm">fastapi.security</span> <span class="im">import</span> <span class="nm">HTTPBearer</span><span class="op">,</span> <span class="nm">HTTPAuthCredentials</span>
<span class="im">import</span> <span class="nm">jwt</span>
<span class="im">from</span> <span class="nm">datetime</span> <span class="im">import</span> <span class="nm">datetime</span><span class="op">,</span> <span class="nm">timedelta</span>

<span class="nm">SECRET_KEY</span> <span class="op">=</span> <span class="st">"your-secret-key-here"</span>
<span class="nm">ALGORITHM</span> <span class="op">=</span> <span class="st">"HS256"</span>
<span class="nm">security</span> <span class="op">=</span> <span class="fn">HTTPBearer</span><span class="op">()</span>

<span class="kw">def</span> <span class="fn">create_access_token</span><span class="op">(</span><span class="nm">data</span><span class="op">:</span> <span class="bi">dict</span><span class="op">,</span> <span class="nm">expires_delta</span><span class="op">:</span> <span class="bi">int</span> <span class="op">=</span> <span class="nm">3600</span><span class="op">):</span>
    <span class="nm">to_encode</span> <span class="op">=</span> <span class="nm">data</span><span class="op">.</span><span class="fn">copy</span><span class="op">()</span>
    <span class="nm">expire</span> <span class="op">=</span> <span class="nm">datetime</span><span class="op">.</span><span class="fn">utcnow</span><span class="op">()</span> <span class="op">+</span> <span class="nm">timedelta</span><span class="op">(</span><span class="nm">seconds</span><span class="op">=</span><span class="nm">expires_delta</span><span class="op">)</span>
    <span class="nm">to_encode</span><span class="op">.</span><span class="fn">update</span><span class="op">({</span><span class="st">"exp"</span><span class="op">:</span> <span class="nm">expire</span><span class="op">})</span>
    <span class="nm">token</span> <span class="op">=</span> <span class="nm">jwt</span><span class="op">.</span><span class="fn">encode</span><span class="op">(</span><span class="nm">to_encode</span><span class="op">,</span> <span class="nm">SECRET_KEY</span><span class="op">,</span> <span class="nm">algorithm</span><span class="op">=</span><span class="nm">ALGORITHM</span><span class="op">)</span>
    <span class="kw">return</span> <span class="nm">token</span>

<span class="kw">async def</span> <span class="fn">verify_token</span><span class="op">(</span><span class="nm">credentials</span><span class="op">:</span> <span class="nm">HTTPAuthCredentials</span> <span class="op">=</span> <span class="fn">Depends</span><span class="op">(</span><span class="nm">security</span><span class="op">)):</span>
    <span class="kw">try</span><span class="op">:</span>
        <span class="nm">payload</span> <span class="op">=</span> <span class="nm">jwt</span><span class="op">.</span><span class="fn">decode</span><span class="op">(</span>
            <span class="nm">credentials</span><span class="op">.</span><span class="nm">credentials</span><span class="op">,</span>
            <span class="nm">SECRET_KEY</span><span class="op">,</span>
            <span class="nm">algorithms</span><span class="op">=</span><span class="op">[</span><span class="nm">ALGORITHM</span><span class="op">]</span>
        <span class="op">)</span>
        <span class="nm">user_id</span> <span class="op">=</span> <span class="nm">payload</span><span class="op">.</span><span class="fn">get</span><span class="op">(</span><span class="st">"sub"</span><span class="op">)</span>
    <span class="kw">except</span> <span class="nm">jwt</span><span class="op">.</span><span class="nm">ExpiredSignatureError</span><span class="op">:</span>
        <span class="kw">raise</span> <span class="fn">HTTPException</span><span class="op">(</span><span class="nm">status_code</span><span class="op">=</span><span class="nm">401</span><span class="op">,</span> <span class="nm">detail</span><span class="op">=</span><span class="st">"Token expired"</span><span class="op">)</span>
    <span class="kw">except</span> <span class="nm">jwt</span><span class="op">.</span><span class="nm">InvalidTokenError</span><span class="op">:</span>
        <span class="kw">raise</span> <span class="fn">HTTPException</span><span class="op">(</span><span class="nm">status_code</span><span class="op">=</span><span class="nm">401</span><span class="op">,</span> <span class="nm">detail</span><span class="op">=</span><span class="st">"Invalid token"</span><span class="op">)</span>
    <span class="kw">return</span> <span class="nm">user_id</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/token"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">get_token</span><span class="op">(</span><span class="nm">user_id</span><span class="op">:</span> <span class="bi">str</span><span class="op">):</span>
    <span class="nm">token</span> <span class="op">=</span> <span class="fn">create_access_token</span><span class="op">({</span><span class="st">"sub"</span><span class="op">:</span> <span class="nm">user_id</span><span class="op">})</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"access_token"</span><span class="op">:</span> <span class="nm">token</span><span class="op">,</span> <span class="st">"token_type"</span><span class="op">:</span> <span class="st">"bearer"</span><span class="op">}</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/predict"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">predict</span><span class="op">(</span>
    <span class="nm">request</span><span class="op">:</span> <span class="nm">TextRequest</span><span class="op">,</span>
    <span class="nm">user_id</span><span class="op">:</span> <span class="bi">str</span> <span class="op">=</span> <span class="fn">Depends</span><span class="op">(</span><span class="fn">verify_token</span><span class="op">)</span>
<span class="op">):</span>
    <span class="cm"># Only authenticated users can call this</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"user"</span><span class="op">:</span> <span class="nm">user_id</span><span class="op">,</span> <span class="st">"result"</span><span class="op">:</span> <span class="st">"prediction"</span><span class="op">}</span></code></div>

    <div class="callout">
      <div class="callout-title">JWT Best Practices</div>
      <p>Store secrets in environment variables, use short expiration times (15 minutes), implement refresh tokens for longer sessions, and always use HTTPS to prevent token interception.</p>
    </div>
  </section>

  <section class="section" id="rate-limiting">
    <h2>Rate Limiting with Token Bucket</h2>
    <p>Implement the Token Bucket algorithm to allow bursts while limiting sustained traffic:</p>
    <div class="code-example"><code><span class="im">import</span> <span class="nm">time</span>
<span class="im">import</span> <span class="nm">redis</span>

<span class="kw">class</span> <span class="nm">RateLimiter</span><span class="op">:</span>
    <span class="kw">def</span> <span class="fn">__init__</span><span class="op">(</span><span class="nm">self</span><span class="op">,</span> <span class="nm">redis_url</span><span class="op">):</span>
        <span class="nm">self</span><span class="op">.</span><span class="nm">redis</span> <span class="op">=</span> <span class="nm">redis</span><span class="op">.</span><span class="fn">from_url</span><span class="op">(</span><span class="nm">redis_url</span><span class="op">)</span>

    <span class="kw">def</span> <span class="fn">allow_request</span><span class="op">(</span>
        <span class="nm">self</span><span class="op">,</span> <span class="nm">user_id</span><span class="op">:</span> <span class="bi">str</span><span class="op">,</span>
        <span class="nm">requests_per_minute</span><span class="op">:</span> <span class="bi">int</span> <span class="op">=</span> <span class="nm">60</span><span class="op">,</span>
        <span class="nm">burst_size</span><span class="op">:</span> <span class="bi">int</span> <span class="op">=</span> <span class="nm">10</span>
    <span class="op">):</span>
        <span class="nm">key</span> <span class="op">=</span> <span class="st">f"rate_limit:{user_id}"</span>
        <span class="nm">now</span> <span class="op">=</span> <span class="fn">time</span><span class="op">.</span><span class="fn">time</span><span class="op">()</span>
        <span class="nm">refill_rate</span> <span class="op">=</span> <span class="nm">requests_per_minute</span> <span class="op">/</span> <span class="nm">60</span>

        <span class="nm">pipe</span> <span class="op">=</span> <span class="nm">self</span><span class="op">.</span><span class="nm">redis</span><span class="op">.</span><span class="fn">pipeline</span><span class="op">()</span>
        <span class="nm">data</span> <span class="op">=</span> <span class="nm">self</span><span class="op">.</span><span class="nm">redis</span><span class="op">.</span><span class="fn">hgetall</span><span class="op">(</span><span class="nm">key</span><span class="op">)</span>

        <span class="nm">tokens</span> <span class="op">=</span> <span class="fn">float</span><span class="op">(</span><span class="nm">data</span><span class="op">.</span><span class="fn">get</span><span class="op">(</span><span class="st">b"tokens"</span><span class="op">,</span> <span class="nm">burst_size</span><span class="op">))</span>
        <span class="nm">last_refill</span> <span class="op">=</span> <span class="fn">float</span><span class="op">(</span><span class="nm">data</span><span class="op">.</span><span class="fn">get</span><span class="op">(</span><span class="st">b"last_refill"</span><span class="op">,</span> <span class="nm">now</span><span class="op">))</span>

        <span class="nm">elapsed</span> <span class="op">=</span> <span class="nm">now</span> <span class="op">-</span> <span class="nm">last_refill</span>
        <span class="nm">tokens</span> <span class="op">=</span> <span class="fn">min</span><span class="op">(</span><span class="nm">burst_size</span><span class="op">,</span> <span class="nm">tokens</span> <span class="op">+</span> <span class="nm">refill_rate</span> <span class="op">*</span> <span class="nm">elapsed</span><span class="op">)</span>

        <span class="kw">if</span> <span class="nm">tokens</span> <span class="op">>=</span> <span class="nm">1</span><span class="op">:</span>
            <span class="nm">self</span><span class="op">.</span><span class="nm">redis</span><span class="op">.</span><span class="fn">hset</span><span class="op">(</span><span class="nm">key</span><span class="op">,</span> <span class="nm">mapping</span><span class="op">={</span>
                <span class="st">"tokens"</span><span class="op">:</span> <span class="nm">tokens</span> <span class="op">-</span> <span class="nm">1</span><span class="op">,</span>
                <span class="st">"last_refill"</span><span class="op">:</span> <span class="nm">now</span>
            <span class="op">})</span>
            <span class="self.redis.expire(key, 3600)</span>
            <span class="kw">return</span> <span class="kw">True</span>
        <span class="kw">return</span> <span class="kw">False</span>

<span class="nm">limiter</span> <span class="op">=</span> <span class="fn">RateLimiter</span><span class="op">(</span><span class="st">"redis://localhost:6379"</span><span class="op">)</span>

<span class="op">@</span><span class="nm">app</span><span class="op">.</span><span class="fn">post</span><span class="op">(</span><span class="st">"/predict"</span><span class="op">)</span>
<span class="kw">async def</span> <span class="fn">predict</span><span class="op">(</span>
    <span class="nm">request</span><span class="op">:</span> <span class="nm">TextRequest</span><span class="op">,</span>
    <span class="nm">user_id</span><span class="op">:</span> <span class="bi">str</span> <span class="op">=</span> <span class="fn">Depends</span><span class="op">(</span><span class="fn">verify_token</span><span class="op">)</span>
<span class="op">):</span>
    <span class="kw">if</span> <span class="kw">not</span> <span class="nm">limiter</span><span class="op">.</span><span class="fn">allow_request</span><span class="op">(</span><span class="nm">user_id</span><span class="op">,</span> <span class="nm">requests_per_minute</span><span class="op">=</span><span class="nm">100</span><span class="op">):</span>
        <span class="kw">raise</span> <span class="fn">HTTPException</span><span class="op">(</span><span class="nm">status_code</span><span class="op">=</span><span class="nm">429</span><span class="op">,</span> <span class="nm">detail</span><span class="op">=</span><span class="st">"Rate limit exceeded"</span><span class="op">)</span>
    <span class="kw">return</span> <span class="op">{</span><span class="st">"result"</span><span class="op">:</span> <span class="st">"prediction"</span><span class="op">}</span></code></div>
  </section>

